# PSM.Intern Platform Environment Configuration

# --- Application Security ---
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database Setup ---
# Local SQLite fallback:
# DATABASE_URL=sqlite:///./psm_intern.db
# Supabase PostgreSQL (IPv4 Session Pooler Port 5432 - Recommended):
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[ENCODED_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# --- Supabase Keys (Optional for REST / Storage) ---
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...

# --- Frontend & CORS ---
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# --- Storage Directories ---
STORAGE_DIR=./storage
CERTIFICATES_DIR=./storage/certificates
QR_CODES_DIR=./storage/qrcodes

# --- Initial Administrator Bootstrap Credentials ---
INITIAL_ADMIN_EMAIL=admin@psmintern.com
INITIAL_ADMIN_PASSWORD=AdminPSM@2026!
INITIAL_ADMIN_NAME=System Administrator

# --- Optional SMTP Mail Settings ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_api_key
# EMAILS_FROM_EMAIL=no-reply@psmintern.com
